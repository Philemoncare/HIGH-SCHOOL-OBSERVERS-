# Server Configuration
NODE_ENV=development
PORT=5000
# Frontend URL used in emails and CORS. Set this to your deployed frontend (e.g. Vercel).
# - Local: http://localhost:5173
# - Production: https://your-app.vercel.app or https://your-domain.com
FRONTEND_URL=http://localhost:5173
# Backend URL (for CORS). On Render, set to your service URL.
BACKEND_URL=https://high-school-observers-backend.onrender.com
# Extra CORS origins (comma-separated), e.g. https://www.yourdomain.com
ALLOWED_ORIGINS=

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hso_database
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google Sign-In (same Client ID as frontend; create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Payment Gateway Configuration (Paystack)
# Get your keys from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# --- Deploying on Render ---
# Render sets PORT automatically. In Render Dashboard → Environment, add:
#   NODE_ENV = production
#   DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD (or DATABASE_URL if you update `src/database/postgres.js` to use it)
#   JWT_SECRET = (strong random secret)
#   FRONTEND_URL = https://high-school-observers-frontend.vercel.app
#   BACKEND_URL = https://high-school-observers-backend.onrender.com
#   GOOGLE_CLIENT_ID = (same as VITE_GOOGLE_CLIENT_ID on Vercel)
# Add other keys (Paystack, Cloudinary, SMTP, etc.) as needed.